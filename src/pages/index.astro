---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate, href, site } from '../lib/site';
import { loadData } from '../lib/data';

const { parties, topics, pledges } = await loadData();
const candidates = await getCollection('candidates');
const totalPledges = pledges.length;
---

<BaseLayout>
	<h1>Victorian state election 2026: party pledges compared</h1>
	<p class="lead">
		What are the parties promising for Victoria? Browse each party's pledges, compare them side by side by topic,
		and follow the links to the original policy documents. This site summarises what parties say — it does not
		endorse, score or rank them.
	</p>
	<div class="notice">
		<strong>Election day is Saturday {formatDate(site.electionDate)}.</strong>{' '}
		Sources were checked on {formatDate(site.dataLastVerified)} and parties continue to announce new policies. Always check the linked source.
	</div>

	<div class="stats">
		<div><div class="stat">{parties.length}</div> parties</div>
		<div><div class="stat">{totalPledges}</div> pledges</div>
		<div><div class="stat">{topics.length}</div> topics</div>
	</div>

	<h2 id="parties">Parties, candidates and policy documents</h2>
	<p>Meet the state leaders and featured candidates for each party. Select a name to read their biography, or <a href="https://www.vec.vic.gov.au/voting/2026-state-election/find-candidates" target="_blank" rel="noopener noreferrer">find all candidates in your electorate at the Victorian Electoral Commission ↗</a>.</p>
	<p>
		Unsure which party's priorities line up with yours? <a href={href('quiz/')}>Take the priorities quiz</a> to see which parties' published pledges overlap most with the issues you care about. It is an alignment check, not voting advice.
	</p>
	<ul class="grid grid-3" style="list-style:none;padding:0;">
		{
			parties.map((party) => {
				const count = pledges.filter((p) => p.partyData.id === party.id || p.jointParties.some((j) => j.id === party.id)).length;
				return (
					<li class="card party-card" style={`--party-colour:${party.data.colour}`}>
						<h3>{party.data.shortName}</h3>
						<p class="meta">{party.data.name}</p>
						<ul class="candidate-links">
							{candidates.filter((c) => c.data.partyId.id === party.id).map(({ id, data }) => (
								<li>
									<a href={href(`candidates/${id}/`)}>
										<img src={data.portraitUrl ?? href(`candidates/${id}.jpg`)} width="52" height="52" loading="lazy" referrerpolicy="no-referrer" alt="" />
										<span><strong>{data.name}</strong><small>{data.role}</small></span>
									</a>
								</li>
							))}
						</ul>
						<p>{count} {count === 1 ? 'pledge' : 'pledges'} recorded</p>
						{party.data.limitedInformation && <p class="meta">Limited published policy — see <a href={href('about/')}>method</a>.</p>}
						<div class="party-links">
							<a href={href(`parties/${party.id}/`)}>See pledges →</a>
							<a href={party.data.manifestoUrl} target="_blank" rel="noopener noreferrer">Manifesto / policies ↗</a>
							{party.data.manifestoPdf && <a href={party.data.manifestoPdf} target="_blank" rel="noopener noreferrer">PDF ↗</a>}
							{party.data.archiveUrl && <a href={party.data.archiveUrl} target="_blank" rel="noopener noreferrer">Archived snapshot ↗</a>}
						</div>
					</li>
				);
			})
		}
	</ul>

	<h2>Compare the parties</h2>
	<p>See pledges side by side, or choose a topic from the Compare menu above.</p>
	<p><a href={href('compare/')}><strong>Open the comparison page →</strong></a></p>

	<h2>How to read this site</h2>
	<p>
		Every pledge has a short neutral summary, the cost where the party or an independent body has stated one,
		and a link to the source. Quotations are verbatim. Where the Liberal Party and The Nationals announced a
		pledge jointly, it appears once and is marked as shared by both parties. See <a href={href('about/')}>About</a>
		for the method and limitations.
	</p>
</BaseLayout>
