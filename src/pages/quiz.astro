---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/site';
import { loadData } from '../lib/data';

const { topics } = await loadData();
const dataUrl = href('quiz-data.json');
const topicNames = new Map(topics.map((t) => [t.id, t.data.name]));

// Each question offers four topics; together the five questions cover the nine policy topics.
const questions = [
	{ prompt: 'Which of these would make the biggest difference to your everyday life?', options: ['cost-of-living', 'health', 'housing', 'transport'] },
	{ prompt: 'Which public service do you think needs the most attention?', options: ['health', 'education', 'crime-justice', 'environment-energy'] },
	{ prompt: 'What worries you most about Victoria’s future?', options: ['environment-energy', 'economy-tax', 'housing', 'integrity'] },
	{ prompt: 'Which issue would you most like your local representative to focus on?', options: ['crime-justice', 'transport', 'education', 'cost-of-living'] },
	{ prompt: 'If one area received extra funding, which should it be?', options: ['housing', 'integrity', 'economy-tax', 'health'] },
];
const questionCount = questions.length;
---

<BaseLayout title="Priorities alignment – Victorian Election 2026" description="Choose the issues you care about and see which parties' recorded pledges overlap most with those priorities.">
	<h1>Priorities alignment</h1>
	<p class="lead">Choose the issues that matter most to you. We'll compare your choices with the topics covered by each party's recorded pledges and show the closest overlaps, with links to the original sources.</p>

	<div class="notice">
		<strong>This is not voting advice or a recommendation.</strong> It does not say which party you should vote for, and it is not a ranking of parties. It only measures how closely the topics you picked match the topics each party has published pledges on. It says nothing about whether you agree with those pledges, their quality, or how a party would perform.
	</div>

	<p class="meta" id="quiz-status" aria-live="polite">Loading quiz data…</p>

	<form id="quiz-form">
		{questions.map((q, i) => (
			<fieldset class="quiz-question">
				<legend><strong>{i + 1}. {q.prompt}</strong></legend>
				<div class="quiz-options">
					{q.options.map((id) => (
						<label>
							<input type="radio" name={`q${i}`} value={id} />
							<span>{topicNames.get(id)}</span>
						</label>
					))}
				</div>
			</fieldset>
		))}
		<div class="quiz-actions">
			<button type="submit" class="primary">Show my overlaps</button>
			<button type="reset" class="secondary">Clear answers</button>
		</div>
	</form>

	<section id="quiz-results" hidden aria-live="polite">
		<h2>Parties whose pledges overlap most with your priorities</h2>
		<p class="meta">These are the three closest overlaps. Read the linked pledges and the original sources before drawing any conclusion.</p>
		<div id="result-list"></div>
		<details>
			<summary>How this is calculated</summary>
			<p>For each party we count how many of its recorded pledges (including joint pledges) fall in each topic, then express that as a share of its pledges. Your answers give each chosen topic a weight. The overlap figure is the cosine similarity between your weights and each party's topic distribution: 100% means the shape of your priorities matches the shape of that party's published pledges as closely as possible. A party with no pledges on your chosen topics scores 0%.</p>
			<p>This measure reflects what this site has recorded and how pledges were grouped into topics. It cannot measure agreement with a policy, the strength of a commitment, or likely performance. See <a href={href('about/')}>how this site works</a> for the methodology and limitations.</p>
		</details>
	</section>
</BaseLayout>

<script define:vars={{ dataUrl, questionCount }}>
	const form = document.getElementById('quiz-form');
	const statusEl = document.getElementById('quiz-status');
	const resultsEl = document.getElementById('quiz-results');
	const listEl = document.getElementById('result-list');
	let data = null;

	fetch(dataUrl)
		.then((r) => { if (!r.ok) throw new Error('bad response'); return r.json(); })
		.then((d) => {
			data = d;
			statusEl.textContent = 'Answer all ' + questionCount + ' questions, then select Show my overlaps.';
		})
		.catch(() => { statusEl.textContent = 'Could not load the quiz data.'; });

	form.addEventListener('submit', function (e) {
		e.preventDefault();
		if (!data) return;

		const selected = [];
		for (let i = 0; i < questionCount; i++) {
			const checked = form.querySelector('input[name="q' + i + '"]:checked');
			if (!checked) {
				statusEl.textContent = 'Please answer question ' + (i + 1) + '.';
				return;
			}
			selected.push(checked.value);
		}

		statusEl.textContent = 'Based on ' + selected.length + ' answers.';
		const weights = {};
		selected.forEach((id) => { weights[id] = (weights[id] || 0) + 1; });
		const chosenTopics = Object.keys(weights);
		const topicIds = data.topics.map((t) => t.id);

		function cosine(a, b) {
			let dot = 0, na = 0, nb = 0;
			topicIds.forEach((id) => {
				const x = a[id] || 0, y = b[id] || 0;
				dot += x * y; na += x * x; nb += y * y;
			});
			return na && nb ? dot / (Math.sqrt(na) * Math.sqrt(nb)) : 0;
		}

		const ranked = data.parties
			.map((p) => ({ party: p, score: cosine(weights, p.counts) }))
			.sort((a, b) => b.score - a.score);

		listEl.replaceChildren();
		ranked.slice(0, 3).forEach((entry, index) => {
			const p = entry.party;
			const pct = Math.round(entry.score * 100);
			const onTopics = chosenTopics.reduce((n, id) => n + (p.counts[id] || 0), 0);

			const card = document.createElement('div');
			card.className = 'card score-item';
			card.style.borderTop = '5px solid ' + p.colour;

			const head = document.createElement('div');
			head.className = 'score-head';
			const name = document.createElement('strong');
			name.textContent = (index + 1) + '. ' + p.name;
			const score = document.createElement('span');
			score.className = 'meta';
			score.textContent = pct + '% overlap';
			head.append(name, score);

			const bar = document.createElement('div');
			bar.className = 'score-bar';
			const fill = document.createElement('span');
			fill.style.width = pct + '%';
			fill.style.background = p.colour;
			bar.append(fill);

			const info = document.createElement('p');
			info.className = 'meta';
			info.textContent = p.total + ' recorded pledges, of which ' + onTopics + ' are on the topics you selected.';

			const ul = document.createElement('ul');
			ul.className = 'match-list';
			data.pledges
				.filter((pl) => pl.partyIds.indexOf(p.id) !== -1 && chosenTopics.indexOf(pl.topicId) !== -1)
				.slice(0, 3)
				.forEach((pl) => {
					const li = document.createElement('li');
					const a = document.createElement('a');
					a.href = pl.url;
					a.textContent = pl.title;
					li.append(a);
					ul.append(li);
				});
			if (!ul.children.length) {
				const li = document.createElement('li');
				li.textContent = 'No pledges recorded on your selected topics.';
				ul.append(li);
			}

			card.append(head, bar, info, ul);
			listEl.append(card);
		});

		resultsEl.hidden = false;
		resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});

	form.addEventListener('reset', function () {
		resultsEl.hidden = true;
		listEl.replaceChildren();
		statusEl.textContent = 'Answer all ' + questionCount + ' questions, then select Show my overlaps.';
	});
</script>
