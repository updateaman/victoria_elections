---
import '../styles/global.css';
import { base, href, site } from '../lib/site';
import { loadData } from '../lib/data';

interface Props {
	title?: string;
	description?: string;
}

interface NavItem {
	href: string;
	label: string;
	match: boolean;
	children?: { href: string; label: string; match: boolean }[];
}

const { title = site.title, description = site.description } = Astro.props;
const ogImage = new URL(href('og-image.jpg'), Astro.site ?? 'http://localhost:4321').href;
const { topics } = await loadData();
const path = Astro.url.pathname.replace(base.replace(/\/$/, ''), '') || '/';
const nav: NavItem[] = [
	{ href: href(''), label: 'Home', match: path === '/' },
	{
		href: href('compare/'),
		label: 'Compare',
		match: path.startsWith('/compare') || path.startsWith('/topics'),
		children: [
			{ href: href('compare/'), label: 'All topics', match: path === '/compare/' || path === '/compare' },
			...topics.map((t) => ({
				href: href(`topics/${t.id}/`),
				label: t.data.name,
				match: path.startsWith(`/topics/${t.id}`),
			})),
		],
	},
	{ href: href('search/'), label: 'Search', match: path.startsWith('/search') },
	{ href: href('quiz/'), label: 'Quiz', match: path.startsWith('/quiz') },
	{ href: href('about/'), label: 'About', match: path.startsWith('/about') },
];
---

<!doctype html>
<html lang="en-AU">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
		<link rel="icon" href={href('favicon.ico')} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Four party leaders beside the title Victorian Election 2026: party pledges compared" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="wrap">
				<a class="brand" href={href('')}>VIC <span>Election 2026</span></a>
				<nav aria-label="Main navigation">
					<ul>
						{nav.map((item) => (
							<li class={item.children ? 'has-submenu' : undefined}>
								<div class="nav-row">
									<a href={item.href} aria-current={item.match && !item.children ? 'page' : undefined}>{item.label}</a>
									{item.children && (
										<button type="button" class="submenu-toggle" aria-expanded="false" aria-controls="compare-submenu" aria-label="Show Compare topics">▾</button>
									)}
								</div>
								{item.children && (
									<ul class="submenu" id="compare-submenu">
										{item.children.map((child) => (
											<li><a href={child.href} aria-current={child.match ? 'page' : undefined}>{child.label}</a></li>
										))}
									</ul>
								)}
							</li>
						))}
					</ul>
				</nav>
			</div>
		</header>
		<main id="main" class="wrap">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="wrap">
				<p>Independent, non-partisan reference. Summaries of party pledges; always check the linked source before voting. This site does not endorse any party.</p>
				<p>
					Data last verified {new Date(`${site.dataLastVerified}T00:00:00Z`).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}.
					<a href={`mailto:${site.contactEmail}`}>Report an error</a> · <a href={href('about/')}>How this works</a>
				</p>
				<p>{site.authorisation}</p>
			</div>
		</footer>
		<script>
			const toggles = document.querySelectorAll('.submenu-toggle');

			function closeMenus() {
				toggles.forEach((btn) => {
					btn.closest('.has-submenu')?.classList.remove('open');
					btn.setAttribute('aria-expanded', 'false');
				});
			}

			toggles.forEach((btn) => {
				btn.addEventListener('click', () => {
					const isOpen = btn.closest('.has-submenu').classList.toggle('open');
					btn.setAttribute('aria-expanded', String(isOpen));
				});
			});

			document.addEventListener('click', (e) => {
				if (!(e.target instanceof Element) || !e.target.closest('.has-submenu')) closeMenus();
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					closeMenus();
					toggles[0]?.focus();
				}
			});
		</script>
	</body>
</html>
